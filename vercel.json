{
  "version": 2,
  "buildCommand": "pnpm install --ignore-scripts && pnpm build:web",
  "outputDirectory": "dist-web",
  "installCommand": "pnpm install --ignore-scripts",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
