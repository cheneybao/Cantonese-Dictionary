{
  "miniprogramRoot": "./dist",
  "projectname": "cantonese-dictionary",
  "description": "粤语词典 - 离线优先的粤语学习工具",
  "appid": "touristappid",
  "setting": {
    "urlCheck": false,
    "es6": true,
    "enhance": true,
    "compileHotReLoad": true,
    "postcss": true,
    "minified": true
  },
  "compileType": "miniprogram",
  "packOptions": {
    "ignore": [
      {
        "type": "folder",
        "value": "./assets"
      },
      {
        "type": "file",
        "value": ".gitignore"
      },
      {
        "type": "file",
        "value": "README.md"
      }
    ]
  }
}
